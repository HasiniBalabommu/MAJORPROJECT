<% layout("layouts/boilerplate")%>
<body>
    <form method="POST" action="/listings" novalidate class="needs-validation" enctype="multipart/form-data">
    <div class="row">
        <div class="col-8 offset-2">
            <h3>Create a new Listing</h3>
            <div class="mb-3">
            <label for="title" class="form-label">Title</label>
            <input name ="listing[title]"type="text" placeholder ="enter title" required class="form-control">
            <div class="valid-feedback">Title looks good</div>
            <!-- the above statement is displyed if valid input is given if you want 
            to display some text when there is invalid input you need to use class invalid-feedback -->
        </div>
        <div class="mb-3">
            <label for="description" class="form-label">Description</label>
             <input name ="listing[description]" type="text" placeholder ="enter description" required class="form-control">
             <div class="invalid-feedback">Please enter a short description</div>
        </div>
        <div class="mb-3">
            <label for="image" class="form-label">Upload Image</label>
             <input name ="listing[image]" type="file" required class="form-control" >
        </div>
    <div class="row">
        <div class="mb-3 col-4">
             <label for="price" class="form-label">Price</label>
             <input  name ="listing[price]" type="number" placeholder ="enter Price"required class="form-control" >
             <div class="invalid-feedback">Please enter valid price</div>
        </div>
        <div class="mb-3 col-8">
            <label for="country" class="form-label">Country</label>
            <input name ="listing[country]"  type="text" placeholder ="enter Country" required class="form-control">
            <div class="invalid-feedback">Country should be valid</div>
        </div>
    </div>
        <div class="mb-3">
            <label for="location" class="form-label">Location</label>
            <input name ="listing[location]"  type="text" placeholder ="enter Location" required class="form-control">
            <div class="invalid-feedback">Location should be valid</div>
        </div>
        <button class="btn btn-dark add-btn">Add</button>
        <br><br>
        </div>
    </div>
    </form>  
</body>

<!-- to reduce the forms input size put everything under div rows and cols and adjust the size accordingly in boot strap rows and cols are divided in the form of 12 by 12 representation  -->