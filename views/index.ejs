<% layout("layouts/boilerplate")%> <%= success %>
<body>
    <style>
        #filters{
            display: flex;
            flex-wrap: wrap;
            margin-bottom: 1rem;
            align-items: center;
        }
        .filter{
            margin-top: 1rem;
            margin-right:1.9rem;
            text-align:center;
            opacity:0.7;
            height:55px;
            width:55px;
            margin-bottom:1rem;
        }
        .filter:hover{
            opacity:1;
            cursor:pointer;
        }
        .filter p{
            font-size: 0.8rem;
        }
        .tax-info{
            display: none;
        }
        .tax-toggle{
            border:1px solid black;
            border-radius:0.6rem;
            height:2.8rem;
            padding: 0.8rem 1rem 1rem 1rem;
            margin-left:2rem;
            display:flex;
            align-items: center;
        }
    </style>
    <!-- <h3>All listings</h3> -->
     <div id="filters">
        <div class="filter">
            <div style="font-size:larger;"><i class="fa-solid fa-fire"></i></div>
            <p>Trending</p>
        </div>
        <div class="filter">
            <div style="font-size:larger;"><i class="fa-solid fa-bed"></i></div>
            <p>Rooms</p>
        </div>
        <div class="filter">
            <div style="font-size:larger;"><i class="fa-solid fa-mountain-city"></i></i></div>
            <p>Iconic cities</p>
        </div>
        <div class="filter">
            <div style="font-size:larger;"><i class="fa-solid fa-mountain"></i></div>
            <p>Mountains</p>
        </div>
        <div class="filter">
            <div style="font-size:larger;"><i class="fa-brands fa-fort-awesome"></i></div>
            <p>castles</p>
        </div>
        <div class="filter">
            <div style="font-size:larger;"><i class="fa-solid fa-person-swimming"></i></div>
            <p>amazing pools</p>
        </div>
        <div class="filter">
            <div style="font-size:larger;"><i class="fa-solid fa-campground"></i></div>
            <p>camping</p>
        </div>
        <div class="filter">
            <div style="font-size:larger;"><i class="fa-solid fa-tractor"></i></div>
            <p>farms</p>
        </div>
        <div class="filter">
            <div style="font-size:larger;"><i class="fa-solid fa-snowflake"></i></div>
            <p>artic</p>
        </div>
        <div class="filter">
            <div style="font-size:larger;"><i class="fa-solid fa-igloo"></i></i></div>
            <p> Domes</p>
        </div>
        <div class="filter">
            <div style="font-size:larger;"><i class="fa-solid fa-ship"></i></i></div>
            <p>Boats</p>
        </div>
    <div class="tax-toggle">
        <!-- form-check-reverse to display text first and button later -->
        <div class="form-check-reverse form-switch ">
            <input class="form-check-input" type="checkbox" role="switch" id="flexswitchCheckDefault">
            <label class="form-check-label" for="switchCheckDefault">Display total after taxes</label>
        </div>
     </div>
     </div>
    <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 rows-cols-xs-1">
    <% for(let listing of alllistings){ %>
    <a href="/listings/<%=listing._id%>" class="listing-link">
    <!-- embedding the entire card into anchor tag so when clicked on it it will automatically redirect to the other pages get the card directly from bootstrap and link wit the content using ejs content   -->
    <div class="card col listing-card">
    <!-- style="width: 20rem;" -->
    <img src="<%= listing.image.url %>" class="card-img-top" style="height: 18rem;" alt="listing_image">
    <!-- here in the source we need to get the image from the databse  we are adding height styling so that all cards can look even and removing width will automatically adjust according to the screen -->
    <div class="card-body">
    <p class="card-text">
        <b><%=listing.title%></b> <br>
        &#8377;<%=listing.price.toLocaleString("en-IN")%>/ night
        <i class="tax-info">&nbsp; &nbsp; +18% GST</i>
    </p>
    </div>
   </div>
   </a>
<% } %>  
</div>

<script>
    let taxswitch = document.getElementById("flexswitchCheckDefault");
    taxswitch.addEventListener("click",()=>{
        let taxinfo = document.getElementsByClassName("tax-info");
        for(info of taxinfo){
            if(info.style.display != "inline"){
                info.style.display="inline";
            }
            else{
                info.style.display="none";
            }
        }
    });
</script>

