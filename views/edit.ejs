<% layout("layouts/boilerplate")%>
<body>
        <form method="POST" action="/listings/<%=listing._id%>?_method=PUT" novalidate class="needs-validation" enctype="multipart/form-data">
        <div class="row col-8 offset-2">
        <h3>Edit your post</h3>
        <div class="mb-3">
        <label for="title" class="form-label">Title</label>
        <input name ="listing[title]"type="text" value="<%=listing.title%>" required class="form-control">
        </div>
        <div class="mb-3">
        <label for="description" class="form-label">Description</label>
        <input name ="listing[description]" type="text" value="<%=listing.description%>" required class="form-control">
        <div class="invalid-feedback">Please enter a short description</div>
        </div>
        <div class="mb-3">
        Orginal Listing Image<br>
        <img src="<%=orginalImageurl%>">
        </div>
        <div class="mb-3">
        <label for="description" class="form-label">Upload new Image:</label>
        <input name ="listing[image]" type="file"class="form-control">
        <div class="invalid-feedback">Image link should be valid</div>
        </div>
        <div class="row">
        <div class="mb-3 col-4">
                <label for="price" class="form-label">Price</label>
                <input  name ="listing[price]" type="number" value="<%=listing.price%>" required class="form-control">
                <div class="invalid-feedback">Please enter valid price</div>
        </div>
        <div class="mb-3 col-8">
                <label for="description" class="form-label">Location</label>
                <input name ="listing[location]"  type="text" value="<%=listing.location%>" required class="form-control">
        </div>
    </div>
    <div class="mb-3">
        <label for="description" class="form-label">Country</label>
        <input name ="listing[country]"  type="text" value="<%=listing.country%>" required class="form-control">
        </div>
</div>
<button class="btn btn-dark offset-2 add-btn">Edit</button>
</form>  
</body>