<% layout("layouts/boilerplate")%>
<div class="row mt-3">
    <div class="col-6 offset-3">
        <form method="POST" action="/login " class="needs-validation" novalidate>
            <h1>Login for Wanderlust</h1>
            <div class="mb-3">
            <label for="username" class="form-label">Username:</label>
            <input name ="username" id ="username" type="text" placeholder ="Enter Username" required class="form-control">
            </div>
            <div class="mb-3">
            <label for="password" class="form-label">password:</label>
            <input name ="password" id ="password" type="password" placeholder ="Enter password" required class="form-control">
            </div>
            <button class="btn btn-success">Login</button>
        </form>
    </div>
</div>