<% layout("layouts/boilerplate")%>
<div class="row mt-3">
    <div class="col-6 offset-3">
        <form method="POST" action="/signup " class="needs-validation" novalidate>
            <h1>Sign up for Wanderlust</h1>
            <div class="mb-3">
            <label for="username" class="form-label">Username:</label>
            <input name ="username" id ="username" type="text" placeholder ="Enter Username" required class="form-control">
            <div class="valid-feedback">looks good</div>
            </div>
            <div class="mb-3">
            <label for="email" class="form-label">Email:</label>
            <input name ="email" id ="email" type="text" placeholder ="Enter mail id" required class="form-control">
            <div class="valid-feedback">looks good</div>
            </div>
            <div class="mb-3">
            <label for="password" class="form-label">Email:</label>
            <input name ="password" id ="password" type="text" placeholder ="Enter password" required class="form-control">
            </div>
            <button class="btn btn-success">Sign up</button>
        </form>
    </div>
</div>